import java.util.Scanner;

public class Q1 {
    static void main() {
        Scanner s = new Scanner(System.in);
        double temperatura = s.nextDouble();

        double tempFah = F(temperatura);
        System.out.println(tempFah);

        double tempKElvin = Kelvin(temperatura);
        System.out.println(tempKElvin);

        double tempReaumur = Reaumur(temperatura);
        System.out.println(tempReaumur);

        double tempRankine = Rankine(temperatura);
        System.out.println(tempRankine);
    }

    public static double F(double temperatura){
          return (temperatura * 9.0 / 5.0) + 32.0;
    }

    public static double Kelvin(double temperatura){
        return (temperatura + 273.15);
    }

    public static double Reaumur(double temperatura){
        return (temperatura * 0.8);
    }

    public static double Rankine(double temperatura){
        return (temperatura * 1.8 + 491.67);
    }

}
