import java.util.Scanner;
public class Questao11 {    

    static int maior(int[] numeros) {
        int maior = numeros[0];

        for (int i = 1; i < numeros.length; i++) {
            if (numeros[i] > maior) {
                maior = numeros[i];
            }
        }

        return maior;
    }

    static int menor(int[] numeros) {
        int menor = numeros[0];

        for (int i = 1; i < numeros.length; i++) {
            if (numeros[i] < menor) {
                menor = numeros[i];
            }
        }

        return menor;
    }

    static int quantidadePares(int[] numeros) {
        int quantidade = 0;

        for (int numero : numeros) {
            if (numero % 2 == 0) {
                quantidade++;
            }
        }

        return quantidade;
    }

    static double media(int[] numeros) {
        int soma = 0;

        for (int numero : numeros) {
            soma += numero;
        }

        return (double) soma / numeros.length;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] numeros = new int[10];

        for (int i = 0; i < 10; i++) {
            numeros[i] = sc.nextInt();
        }

        System.out.println("Maior número: " + maior(numeros));
        System.out.println("Menor número: " + menor(numeros));
        System.out.println("Quantidade de pares: " + quantidadePares(numeros));
        System.out.printf("Média: %.1f%n", media(numeros));

        
    }
}

