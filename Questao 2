        }

        for (int i = 0; i < sexo.length; i++) {
            sexo[i] = s.nextInt();

        }
        
        MaiorH(alturas);
        MenorH(alturas);
    
    }

    public static double MaiorH(double[] alturas){
        double maior = alturas[0];
        for (double num : alturas) {
            if(num > maior){
                maior = num;
            }   
        }
        return maior;
    }

    public static double MenorH(double[] alturas){
        double menor = alturas[0];
        for (double num : alturas) {
            if(num < menor){
                menor = num;
            }   
        }
        return menor;
    }

    public static int Mulheres(int[] sexo){
        int quantidade = 0;

        for (int num : sexo) {
            if(num == 1){
                quantidade++;
            }
        }
        return quantidade;
    }

